; BQ40Z50 Voltage Calibration Sequence (Based on EV2300 Log)
; 1. 0x0071(DAStatus1) Write, delay, Read
B 0x44 0x71 0x00
X 12
R 0x44
X 20

; 2. 0x0072(DAStatus2) Write, delay, Read
B 0x44 0x72 0x00
X 12
R 0x44
X 20

; 3. 0x0A Read
RW 0x0A
X 10

; 4. Repeat 1-3
B 0x44 0x71 0x00
X 12
R 0x44
X 20
B 0x44 0x72 0x00
X 12
R 0x44
X 20
RW 0x0A
X 10

; 5. 0x4000 Write, delay, Read (Calibration data)
B 0x44 0x00 0x40
X 25
R 0x44
X 20

; 6. 0x0057 write, delay, read (CAL_EN check)
B 0x44 0x57 0x00
X 20
R 0x44
X 57

; 7. 0x002D write (Enter CAL mode)
W 0x00 0x002D
X 100

; 8. Check CAL_EN is 1
CHK_CAL 1

; 9. 0xF081 Write (RAW Mode), delay, Read (Sampling)
W 0x00 0xF081
X 225
B 0x44 0x81 0xF0
X 20
A 0x44 200 10

; 10. 0xF080 Write (RAW Mode Off)
W 0x00 0xF080
X 160

; 11. 0x4000 New Data Write, delay, Read
S 0x4000
X 250
B 0x44 0x00 0x40
X 25
R 0x44
X 3

; 12. 0xF080 Write (RAW Mode Off) again
W 0x00 0xF080
X 60

; 13. Check CAL_EN is 0
W 0x00 0x002D
X 100
CHK_CAL 0
