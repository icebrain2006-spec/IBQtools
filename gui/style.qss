/* Deep modern dark theme for Wow Aesthetics */

QMainWindow {
    background-color: #121212;
}

QWidget {
    background-color: #121212;
    color: #E0E0E0;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 10pt;
}

QTabWidget::pane {
    border: 1px solid #333333;
    border-radius: 8px;
    background-color: #1E1E1E;
}

QTabBar::tab {
    background-color: #252525;
    color: #AAAAAA;
    padding: 10px 25px;
    margin-right: 5px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #333333;
    border-bottom: none;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #1E1E1E;
    color: #00E5FF; /* Vibrant cyan */
    border-top: 2px solid #00E5FF;
}

QTabBar::tab:hover:!selected {
    background-color: #333333;
    color: #FFFFFF;
}

QGroupBox {
    border: 1px solid #333333;
    border-radius: 8px;
    margin-top: 10px;
    background-color: #1A1A1A;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 5px;
    color: #BBBBBB;
    font-weight: bold;
    background-color: #121212;
}

/* Base button styling */
QPushButton {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #444444;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3D3D3D;
    border: 1px solid #666666;
}

QPushButton:pressed {
    background-color: #1A1A1A;
}

QPushButton:disabled {
    background-color: transparent;
    color: #555555;
    border: 1px solid #333333;
}

/* Big Start Button */
QPushButton#startBtn {
    background-color: rgba(0, 200, 83, 0.15);
    color: #00E676;
    border: 2px solid #00C853;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
}

QPushButton#startBtn:hover {
    background-color: rgba(0, 200, 83, 0.4);
    border: 2px solid #64DD17;
    color: #FFFFFF;
}

QPushButton#startBtn:pressed {
    background-color: rgba(0, 200, 83, 0.6);
}

QPushButton#startBtn:disabled {
    background-color: transparent;
    color: #555555;
    border: 2px solid #333333;
}

/* Big Stop Button */
QPushButton#stopBtn {
    background-color: rgba(213, 0, 0, 0.15);
    color: #FF1744;
    border: 2px solid #D50000;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
}

QPushButton#stopBtn:hover {
    background-color: rgba(213, 0, 0, 0.4);
    border: 2px solid #FF5252;
    color: #FFFFFF;
}

QPushButton#stopBtn:pressed {
    background-color: rgba(213, 0, 0, 0.6);
}

QPushButton#stopBtn:disabled {
    background-color: transparent;
    color: #555555;
    border: 2px solid #333333;
}

/* Big Check Button */
QPushButton#checkBtn {
    background-color: rgba(100, 100, 100, 0.15);
    color: #EEEEEE;
    border: 2px solid #777777;
    border-radius: 8px;
    font-size: 14px;
    font-weight: bold;
    padding: 10px;
}

QPushButton#checkBtn:hover {
    background-color: rgba(100, 100, 100, 0.4);
    border: 2px solid #AAAAAA;
    color: #FFFFFF;
}

QProgressBar {
    background-color: #2A2A2A;
    border: 1px solid #333333;
    border-radius: 5px;
    text-align: center;
    color: #FFFFFF;
    font-weight: bold;
    height: 12px;
}

QProgressBar::chunk {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0, stop: 0 #00B4DB, stop: 1 #0083B0);
    border-radius: 5px;
}

QTextBrowser {
    background-color: #0A0A0A;
    color: #00FF00;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 10px;
    font-family: "Consolas", "Courier New", monospace;
}

QComboBox, QLineEdit {
    background-color: #252525;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 6px;
    color: #FFFFFF;
    font-size: 10pt;
}

QComboBox QAbstractItemView {
    background-color: #252525;
    color: #FFFFFF;
    selection-background-color: #00E5FF;
    selection-color: #121212;
    border: 1px solid #444444;
    font-size: 10pt;
}

QComboBox:focus, QLineEdit:focus {
    border: 1px solid #00E5FF;
}

QCheckBox {
    spacing: 8px;
    background-color: transparent;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: #252525;
    border: 1px solid #444444;
    border-radius: 4px;
}

QCheckBox::indicator:checked {
    background-color: #00E5FF;
    border: 1px solid #00E5FF;
}

/* Scroll Area & Scroll Bar Styling */
QScrollArea#boardScroll {
    border: none;
    background-color: transparent;
}
QScrollArea#boardScroll > QWidget > QWidget {
    background-color: transparent;
}
QScrollBar:vertical {
    border: none;
    background: #1E1E1E;
    width: 14px;
    margin: 0px 0px 0px 0px;
    border-radius: 7px;
}
QScrollBar::handle:vertical {
    background: #444444;
    min-height: 20px;
    border-radius: 7px;
}
QScrollBar::handle:vertical:hover {
    background: #666666;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
